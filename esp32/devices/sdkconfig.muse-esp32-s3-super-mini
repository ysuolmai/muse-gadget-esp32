# ESP32-S3FH4R2 Super Mini: 4 MB QIO flash and 2 MB embedded quad PSRAM.
# Sources: the ESP32-S3 Super Mini board pinout and ESP32-S3FH4R2 module data.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ESP32S3_I2S_AUDIO=y
CONFIG_MUSE_HEADLESS_BOARD_NAME="ESP32-S3 Super Mini"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_4mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_MUSE_HATCH_COMPACT_BUFFERS=y

# Tap BOOT to start a live voice call; tap again to end it.
CONFIG_MUSE_REALTIME_VOICE=y
CONFIG_HOMEHUB_SETUP_PORTAL=y
