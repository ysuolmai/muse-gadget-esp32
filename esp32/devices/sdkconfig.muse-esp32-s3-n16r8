# ESP32-S3-N16R8 module: 16 MB QIO flash and 8 MB octal PSRAM. The board
# guide documents a CH343P USB-UART port and a separate native USB connector.
# GPIO35-37 are reserved by octal PSRAM; the shared audio wiring uses exposed
# GPIO0, 1, 2, 4 and 5. Sources: the board's User Guide and pinout.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ESP32S3_I2S_AUDIO=y
CONFIG_MUSE_HEADLESS_BOARD_NAME="ESP32-S3-N16R8"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Tap BOOT to start a live voice call; tap again to end it.
CONFIG_MUSE_REALTIME_VOICE=y
CONFIG_HOMEHUB_SETUP_PORTAL=y

# The board guide's COM connector is the CH343P on UART0.
CONFIG_MUSE_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
